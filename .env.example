# Copy to .env.local for local dev, or set these in Vercel's project env vars.
# Required for /api/lead (reciprocal contact capture, §10). Without these set,
# /connect still works but silently skips sending the lead email.

# Personal Gmail used only as the SMTP relay's authenticated sender — generate
# an App Password at https://myaccount.google.com/apppasswords (requires 2FA).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where leads are delivered. Defaults to the card's own email if unset.
LEAD_TO_EMAIL=garrett.scarlett@axis.com

# Required for /admin (editable headshot + current event). In Vercel: connect
# a Blob store and a Redis store to this project under the Storage tab/
# Marketplace. Without them, /admin's edits will fail with a clear error, and
# the public pages fall back to the static config in src/config/card.ts.
#
# Redis auto-populates these:
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# Blob auto-populates BLOB_STORE_ID (+ an automatic OIDC token Vercel injects
# at runtime — no action needed for that part). BLOB_READ_WRITE_TOKEN is an
# older, alternate credential path the SDK also accepts if you ever generate
# one manually; you don't need both.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Shared passphrase gating /admin — pick your own value.
ADMIN_PASSPHRASE=
